# RouteX Environment Configuration

# Map Tile / Basemap Provider (Optional API keys if switching to custom tile providers like Mapbox or Stadia)
VITE_MAP_API_KEY=

# Routing Provider (Optional API key if connecting OpenRouteService or GraphHopper)
VITE_ROUTING_API_KEY=

# Places / POI Provider (Optional API key if connecting Google Places or Foursquare proxy)
VITE_PLACES_API_KEY=

# Default Map Center Coordinates (Optional latitude, longitude)
# VITE_DEFAULT_LAT=28.6139
# VITE_DEFAULT_LNG=77.2090
